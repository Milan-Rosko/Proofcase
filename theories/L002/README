    Helper lemmas:

      coding_soundness_from_accuracy_and_inclusion :
        CodingInternalAccuracy M Gamma code_Slambda_derives ->
        regulator_theory_included M Slambda ->
        forall A,
          regulator_theory_checked_derivable M Gamma
            (code_Slambda_derives A) ->
          regulator_theory_checked_derivable Slambda Gamma A

      checked_derivability_closure_modus_ponens :
        ClosureModusPonens
          (regulator_theory_checked_derivable M Gamma)

      negfixp_yields_undecidable_in_m :
        NegationFixedPointFor
          (regulator_theory_checked_derivable M Gamma) B ->
        MirrorConsistent M Gamma ->
        Undecidable M Gamma B

    Theorems:

      mirror_unrefutability_core :
        ChiEqMInternal M Gamma chi_eq ->
        MirrorConsistent M Gamma ->
        ~ regulator_theory_checked_derivable M Gamma
            (formula_negation chi_eq)

      self_evaluation_one_zero_excluded :
        regulator_theory_included M Slambda ->
        SLambdaConsistent Slambda Gamma ->
        external phi ->
        (external phi -> regulator_theory_checked_derivable Slambda Gamma phi) ->
        ~ regulator_theory_checked_derivable M Gamma
            (formula_negation phi)

      chi_eq_m_internal_from_l001_fixed_point :
        NegationFixedPointFor
          (regulator_theory_checked_derivable M Gamma)
          chi_eq ->
        ChiEqMInternal M Gamma chi_eq

      l001_constructs_chi_eq_m_internal :
        ClosureEvaluationFrame
          (regulator_theory_checked_derivable M Gamma)
          Code ->
        exists chi_eq,
          ChiEqMInternal M Gamma chi_eq

      mirror_unrefutability_from_l001_evaluation :
        ClosureEvaluationFrame
          (regulator_theory_checked_derivable M Gamma)
          Code ->
        MirrorConsistent M Gamma ->
        exists chi_eq,
          ~ regulator_theory_checked_derivable M Gamma
              (formula_negation chi_eq)

      mirror_unrefutability :
        regulator_theory_included M Slambda ->
        InternalInclusionViaCoding M Gamma code_Slambda_derives ->
        CodingInternalAccuracy M Gamma code_Slambda_derives ->
        DiagonalEliminator Slambda M Gamma chi_eq ->
        ChiEqMInternal M Gamma chi_eq ->
        MirrorConsistent M Gamma ->
        ~ regulator_theory_checked_derivable M Gamma
            (formula_negation chi_eq)

      regulator_non_escape :
        regulator_theory_included M Slambda ->
        SLambdaConsistent Slambda Gamma ->
        LocalAuthority M Gamma asif ->
        EscapeReabsorbed M Gamma asif A escape_claim ->
        regulator_theory_checked_derivable M Gamma (formula_negation A) ->
        Escape M Gamma escape_claim ->
        False

      model_regulator_non_escape :
        ModelEmbeddedInRegulator Model Slambda Gamma derives ->
        SLambdaConsistent Slambda Gamma ->
        ModelModusPonens Model derives ->
        ModelLocalAuthority Model derives asif ->
        ModelEscapeReabsorbed Model derives asif m A escape_claim ->
        derives m (formula_negation A) ->
        derives m escape_claim ->
        False

      embedded_authority_stability_limit :
        ModelEmbeddedInRegulator Model Slambda Gamma derives ->
        ModelLocalAuthority Model derives asif ->
        StableRequiresBoundedRecursivePressure Model R ->
        asif m A ->
        Stable R m ->
        derives m A /\
        regulator_theory_checked_derivable Slambda Gamma A /\
        exists bound, BoundedIntrospection Model R bound m

      local_authority_counter_certification_yields_recursive_pressure :
        ModelLocalAuthority Model derives asif ->
        RecursiveDepthPositivePenalty Model R ->
        asif m A ->
        CounterCertificationAt Model R depth m A ->
        derives m A /\
        NestedAuthorityPressure Model asif R depth m A

      nested_authority_pressure_increases_penalty_at_depth :
        RecursiveAuthorityDepthPressure Model asif R ->
        NestedAuthorityPressure Model asif R depth m A ->
        PenaltyAtDepth R depth m < PenaltyAtDepth R (S depth) m

      strict_depth_pressure_unbounded :
        (forall depth,
          PenaltyAtDepth R depth m < PenaltyAtDepth R (S depth) m) ->
        UnboundedRecursivePressure Model R m

      strict_depth_pressure_obstructs_stability :
        StableRequiresBoundedRecursivePressure Model R ->
        (forall depth,
          PenaltyAtDepth R depth m < PenaltyAtDepth R (S depth) m) ->
        ~ Stable R m

      nested_authority_pressure_obstructs_stability :
        RecursiveAuthorityDepthPressure Model asif R ->
        (forall depth,
          NestedAuthorityPressure Model asif R depth m A) ->
        StableRequiresBoundedRecursivePressure Model R ->
        ~ Stable R m

      concrete_model_local_authority :
        ModelLocalAuthority ConcreteModel concrete_derives concrete_asif

      concrete_recursive_approximation_cost :
        RecursiveApproximationCost
          ConcreteModel concrete_recursive_structure

      concrete_penalty_accumulates :
        PenaltyAccumulates ConcreteModel concrete_recursive_structure

      concrete_recursive_approximation_depth_cost :
        RecursiveApproximationDepthCost
          ConcreteModel concrete_recursive_structure

      concrete_recursive_depth_positive_penalty :
        RecursiveDepthPositivePenalty
          ConcreteModel concrete_recursive_structure

      concrete_recursive_authority_pressure :
        RecursiveAuthorityPressure
          ConcreteModel concrete_asif concrete_recursive_structure

      concrete_recursive_authority_depth_pressure :
        RecursiveAuthorityDepthPressure
          ConcreteModel concrete_asif concrete_recursive_structure

      concrete_stable_requires_bounded_recursive_pressure :
        StableRequiresBoundedRecursivePressure
          ConcreteModel concrete_recursive_structure

      concrete_counter_certification_at_authority :
        forall (depth : nat) (m : ConcreteModel),
          CounterCertificationAt
            ConcreteModel concrete_recursive_structure depth m
            concrete_authority_formula

      concrete_nested_authority_pressure_at_authority :
        forall (depth : nat) (m : ConcreteModel),
          NestedAuthorityPressure
            ConcreteModel concrete_asif concrete_recursive_structure depth m
            concrete_authority_formula

      concrete_authority_counter_certification_yields_recursive_pressure :
        forall (depth : nat) (m : ConcreteModel),
          concrete_derives m concrete_authority_formula /\
          NestedAuthorityPressure
            ConcreteModel concrete_asif concrete_recursive_structure depth m
            concrete_authority_formula

      concrete_authority_penalty_increases :
        forall (depth : nat) (m : ConcreteModel),
          PenaltyAtDepth concrete_recursive_structure depth m <
          PenaltyAtDepth concrete_recursive_structure (S depth) m

      concrete_unbounded_recursive_pressure :
        forall m : ConcreteModel,
          UnboundedRecursivePressure ConcreteModel concrete_recursive_structure m

      concrete_nested_authority_pressure_obstructs_stability :
        forall m : ConcreteModel,
          ~ Stable concrete_recursive_structure m

      concrete_model_pattern :
        CONCRETE_MODEL_PATTERN

      evaluation_frame_yields_undecidable_in_m :
        ClosureEvaluationFrame
          (regulator_theory_checked_derivable M Gamma)
          Code ->
        MirrorConsistent M Gamma ->
        exists B, Undecidable M Gamma B

      enablement_of_falsehoods :
        ClosureEvaluationFrame
          (regulator_theory_checked_derivable M Gamma)
          Code ->
        MirrorConsistent M Gamma ->
        exists Phi,
          ~ regulator_theory_checked_derivable M Gamma Phi

      paradox_of_the_external :
        ClosureEvaluationFrame
          (regulator_theory_checked_derivable M Gamma)
          Code ->
        MirrorConsistent M Gamma ->
        (forall phi, asif (undec_witness phi)) ->
        exists phi, Undecidable M Gamma phi /\ asif (undec_witness phi)

      perpetuity_of_ignorance :
        ClosureEvaluationFrame
          (regulator_theory_checked_derivable Slambda Gamma)
          Code ->
        SLambdaConsistent Slambda Gamma ->
        exists phi,
          ~ regulator_theory_checked_derivable Slambda Gamma phi

      impossibility_of_perfect_doubt :
        ClosureEvaluationFrame
          (regulator_theory_checked_derivable M Gamma)
          Code ->
        MirrorConsistent M Gamma ->
        asif trust ->
        exists perfect,
          ~ regulator_theory_checked_derivable M Gamma perfect /\ asif trust

      incomprehensibility_of_symbolic_regulation :
        ClosureEvaluationFrame
          (regulator_theory_checked_derivable M Gamma)
          Code ->
        SLambdaIncomplete M Slambda Gamma ->
        MirrorConsistent M Gamma ->
        SLambdaIncomplete M Slambda Gamma /\
        exists success,
          ~ regulator_theory_checked_derivable M Gamma success


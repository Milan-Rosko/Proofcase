      ASCENT_BOUNDS_CONTRACT                        (bounded family)
      PROLIFERATION_CONTRACT                        (bounded family)
      LOEB_CONTRACT                                 (K/S, D1-D3)
      GOEDEL_SECOND_CONTRACT                        (K/S, D1-D3)
      LANGUAGE_FIXED_POINT_CONTRACT
      INTERNAL_MODEL_CONTRACT
